# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-token-factory-key
TAVILY_API_KEY=your-tavily-key

# Two models from DIFFERENT families: one writes, the other checks its claims.
# Run `python src/agent.py models` to see what your key can use.
PRIORART_PRIMARY_MODEL=meta-llama/Llama-3.3-70B-Instruct
PRIORART_VERIFIER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# (The template's NEBIUS_MODEL also works as the writer if PRIORART_PRIMARY_MODEL is unset.)

# Optional runtime & production settings
# PRIORART_ENV=development                   # development | staging | production
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# PRIORART_MAX_CANDIDATES=8                  # 1..12 projects compared per check
# PRIORART_RESULTS_PER_QUERY=5               # 1..10
# PRIORART_PAGE_CHARS=9000                   # 1000..12000
# PRIORART_SEARCH_CONCURRENCY=14             # 1..16
# PRIORART_MODEL_CONCURRENCY=8               # 1..16
# PRIORART_CHECK_DEADLINE_S=240              # 10..600 overall check deadline
# PRIORART_MAX_CONCURRENT_CHECKS=4           # 1..32 global concurrent checks
# PRIORART_CACHE=1                           # cache API calls with TTL & single-flight
# PRIORART_DB_PATH=data/priorart.sqlite      # SQLite database path
# PRIORART_ALLOWED_HOSTS=prior-art.example   # comma-separated extra allowed Host headers
# PRIORART_PUBLIC_ORIGIN=https://prior-art.example
# PRIORART_TRUST_PROXY_HEADERS=0             # set 1 only behind a trusted reverse proxy
# PRIORART_RATE_LIMIT_10M=3                  # per-owner checks per 10 minutes
# PRIORART_RATE_LIMIT_DAY=15                 # per-owner checks per day
# PRIORART_RATE_LIMIT_GLOBAL_HOUR=60         # global checks per hour
# PRIORART_DAILY_BUDGET_CREDITS=5000         # daily Tavily credit ceiling
# PRIORART_DAILY_BUDGET_OUTPUT_TOKENS=2000000
# PRIORART_FAKE=1                            # offline demo data (blocked in production)
# PRIORART_SIMULATE=search_down              # failure demo: search_down | extract_down (blocked in production)
